# ── Google Maps（クライアント。VITE_ 接頭辞のものだけがブラウザに露出する）──
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# ── kurobot（Slack ボット連携。共通規格 v1）──
# 全プロジェクトで同じ値。ハブの管理者から受け取る（openssl rand -hex 32 で作ったもの）
KUROBOT_SHARED_SECRET=
# 通知の宛先（デプロイの最後に scripts/notify-release.mjs が叩く）
KUROBOT_HUB_URL=https://kurobot-hub.vercel.app
# 任意。このプロジェクトが既定になる Slack チャンネルID（C…）。複数はカンマ区切り
KUROBOT_SLACK_CHANNELS=

# ── /api/dev-facts が Firestore を読むためのサービスアカウント（Vercel の環境変数に置く）──
# 読み取り専用（roles/datastore.viewer）の鍵の JSON を base64 にしたもの。JSON そのままでも可
FIREBASE_SERVICE_ACCOUNT=
