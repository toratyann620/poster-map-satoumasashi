# リリース署名の設定例。
# 実際の値を書いた keystore.properties を android/ 直下に置くと、
# release ビルドが署名されるようになる。
#
# ⚠️ keystore.properties と .jks（鍵本体）はリポジトリに含めないこと。
#    .gitignore で除外済み。
#
# 鍵の作成コマンド（一度だけ実行し、生成物を安全に保管する）:
#   keytool -genkeypair -v \
#     -keystore poster-map-release.jks \
#     -alias poster-map \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# ⚠️ この鍵を紛失するとアプリを更新できなくなる。
#    Google Play App Signing を有効にすれば、配信用の鍵はGoogle側が保管するため、
#    手元の鍵はアップロード用に限定でき、万一の紛失時も再発行を申請できる。

storeFile=../poster-map-release.jks
storePassword=ここに保管用パスワード
keyAlias=poster-map
keyPassword=ここに鍵のパスワード
