<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Slack の依頼通知のリンク（https://poster-map-app.vercel.app/task/<id>）を
                 ブラウザではなくアプリで開く（App Links）。

                 ⚠️ autoVerify が成立するには、
                 https://poster-map-app.vercel.app/.well-known/assetlinks.json に
                 **Play アプリ署名の証明書の SHA-256** が載っていること。
                 アップロード鍵の指紋だけでは、Play から入れた端末で検証が通らない。
                 検証が通らない間はブラウザ版が開く（依頼は同じように表示される）。

                 ⚠️ パスは /task だけに絞る。host だけで受けるとアプリのURL全体を
                 奪ってしまい、管理画面をブラウザで開けなくなる。

                 launchMode は singleTask のため、起動中に踏まれた場合は
                 画面が作り直されず onNewIntent で届く。JS 側は Capacitor の
                 appUrlOpen で受けている（src/lib/deepLink.ts）。 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="poster-map-app.vercel.app"
                      android:pathPrefix="/task" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 現在地の表示とナビ案内に使用（アプリ表示中のみ。バックグラウンド位置情報は要求しない） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- ポスター写真の撮影に使用 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      写真の「選択」には権限を要求しない。
      @capacitor/camera の pickImages は Android の Photo Picker
      （androidx の PickVisualMedia）を開くだけで、ユーザーが選んだ画像しか
      アプリに渡らない仕組みのため、READ_MEDIA_IMAGES は不要。

      不要な権限を宣言すると、Google Play の「写真と動画の権限」ポリシーにより
      コア機能の申告が求められるうえ、実際より広い権限を要求することになる。
    -->

    <!-- GPS非搭載の端末（タブレット等）でもインストールできるようにする -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
