<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- プッシュ通知の受信に必要。development にしておくと、TestFlight や
	     App Store 配布時には Xcode が自動で production に置き換える。 -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- パスワードの保存・自動入力（iCloudキーチェーン）に必要。

	     ⚠️ capacitor.config.ts で iosScheme を 'https' にしてあるが、iOS では
	     この指定は効かない。WKWebView が自前で扱うスキーム（http/https/file 等）は
	     カスタムスキームハンドラに登録できず、Capacitor が既定の 'capacitor' に
	     戻すため、実際のオリジンは capacitor://poster-map-app.vercel.app になる。
	     オリジンが https でない以上、サイトに保存した資格情報は自動では出てこない。

	     この関連ドメインの宣言と、
	     https://poster-map-app.vercel.app/.well-known/apple-app-site-association
	     の webcredentials の対で、はじめてアプリとサイトが同じものとして扱われる。
	     どちらか片方だけでは機能しない。 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:poster-map-app.vercel.app</string>

		<!-- Slack の依頼通知のリンク（https://poster-map-app.vercel.app/task/<id>）を
		     ブラウザではなくアプリで開くための宣言（Universal Links）。

		     ⚠️ これと
		     https://poster-map-app.vercel.app/.well-known/apple-app-site-association
		     の applinks の対で、はじめて機能する。どちらか片方だけでは効かない。
		     対象は /task/* だけに絞っている。全パスを対象にすると、
		     アプリのURLを開くたびアプリが起動して管理画面などが開けなくなる。

		     ⚠️ AASA は Apple の CDN が取得して配る。公開直後は反映されないことがあり、
		     端末側もアプリの再インストールまで古い内容を持つ。
		     効かないときは、まず公開中の AASA を直接開いて中身を確かめる。 -->
		<string>applinks:poster-map-app.vercel.app</string>
	</array>
</dict>
</plist>
